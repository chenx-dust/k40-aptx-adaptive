+bool A2DP_GetAptxAdaptiveCIE(const uint8_t* p_codec_info,
+                        tA2DP_APTX_ADAPTIVE_CIE *cfg_cie) {
+  return (A2DP_ParseInfoAptxAdaptive(cfg_cie, p_codec_info, false) ==
+          A2DP_SUCCESS);
+}
