+bool A2dpAdaptiveToHalConfig(const ahal_codec_configuration& config, CodecConfiguration* result) {
+  if (config.codec_config.codec_type != BTAV_A2DP_CODEC_INDEX_SOURCE_APTX_ADAPTIVE) return false;
+  tA2DP_APTX_ADAPTIVE_CIE negotiated{};
+  const auto* bytes = config.codec_specific_information_elements;
+  static_assert(AVDT_CODEC_SIZE >= A2DP_APTX_ADAPTIVE_CODEC_LEN + 1);
+  if (!A2DP_GetAptxAdaptiveCIE(bytes, &negotiated)) return false;
+  AptxAdaptiveConfiguration value{};
+  value.sampleRateHz = A2dpCodecToHalSampleRate(config.codec_config);
+  value.bitsPerSample = A2dpCodecToHalBitsPerSample(config.codec_config);
+  if ((value.sampleRateHz != 48000 && value.sampleRateHz != 96000) ||
+      value.bitsPerSample != 24 ||
+      A2DP_VendorGetTrackSampleRateAptxAdaptive(bytes) != value.sampleRateHz) return false;
+  // Match Qualcomm's AIDL mapping: the audio input is mono or joint stereo;
+  // TWS transport details remain in the negotiated sink capability stream.
+  switch (config.codec_config.channel_mode) {
+    case BTAV_A2DP_CODEC_CHANNEL_MODE_MONO:
+      value.channelMode = AptxAdaptiveChannelMode::MONO;
+      break;
+    case BTAV_A2DP_CODEC_CHANNEL_MODE_STEREO:
+      value.channelMode = AptxAdaptiveChannelMode::JOINT_STEREO;
+      break;
+    default:
+      return false;
+  }
+  value.aptxMode = AptxMode::HIGH_QUALITY;
+  value.sinkBufferingMs = {20, 50, 20, 50, 20, 50};
+  const auto& data = negotiated.aptx_data;
+  value.ttp = {static_cast<int8_t>(static_cast<int>(data.ttp_ll_0) - 128),
+               static_cast<int8_t>(static_cast<int>(data.ttp_ll_1) - 128),
+               static_cast<int8_t>(static_cast<int>(data.ttp_hq_0) - 128),
+               static_cast<int8_t>(static_cast<int>(data.ttp_hq_1) - 128),
+               static_cast<int8_t>(static_cast<int>(data.ttp_tws_0) - 128),
+               static_cast<int8_t>(static_cast<int>(data.ttp_tws_1) - 128)};
+  value.inputMode = AptxAdaptiveInputMode::STEREO;
+  value.inputFadeDurationMs = 255;
+  const uint32_t features = data.aptx_adaptive_sup_features;
+  value.aptxAdaptiveConfigStream = {
+      data.cap_ext_ver_num, static_cast<uint8_t>(features),
+      static_cast<uint8_t>(features >> 8), static_cast<uint8_t>(features >> 16),
+      static_cast<uint8_t>(features >> 24), data.first_setup_pref,
+      data.second_setup_pref, data.third_setup_pref, data.fourth_setup_pref,
+      data.eoc0, data.eoc1};
+  result->codecType = CodecType::APTX_ADAPTIVE;
+  result->config.set<CodecConfiguration::CodecSpecific::aptxAdaptiveConfig>(value);
+  return true;
+}
