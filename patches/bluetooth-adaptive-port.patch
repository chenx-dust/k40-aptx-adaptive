+const tA2DP_ENCODER_INTERFACE* A2DP_VendorGetEncoderInterfaceAptxAdaptive(
+    const uint8_t* p_codec_info) {
+  if (!A2DP_IsVendorSourceCodecValidAptxAdaptive(p_codec_info)) return NULL;
+
+  if (!bluetooth::audio::a2dp::is_aptx_adaptive_supported()) return nullptr;
+  // The source session requires an interface even for DSP codecs. Reuse the
+  // platform's offload-only callbacks; these do not encode PCM in software.
+  return A2DP_GetEncoderInterfaceExt(p_codec_info);
+}
