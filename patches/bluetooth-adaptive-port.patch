diff --git a/system/stack/test/a2dp/media_codec_capabilities_test.cc b/system/stack/test/a2dp/media_codec_capabilities_test.cc
index e266912..ee29c39 100644
--- a/system/stack/test/a2dp/media_codec_capabilities_test.cc
+++ b/system/stack/test/a2dp/media_codec_capabilities_test.cc
@@ -18,6 +18,7 @@
 #include <gtest/gtest.h>
 
 #include <cstdint>
+#include <array>
 #include <string>
 
 #include "hardware/bt_av.h"
@@ -132,6 +133,28 @@ namespace bluetooth::a2dp {
 
 class MediaCodecCapabilitiesTest : public ::testing::Test {};
 
+TEST_F(MediaCodecCapabilitiesTest, PreservesFullAdaptiveInformationElement) {
+  static_assert(AVDT_CODEC_SIZE >= 43);
+  std::array<uint8_t, AVDT_CODEC_SIZE> element{};
+  element[0] = 42;
+  element[2] = 0xff;
+  element[3] = 0xd7;  // Qualcomm vendor ID, little endian.
+  element[7] = 0xad;  // Adaptive codec ID, little endian.
+  // Nonzero bytes beyond the former 20-byte capacity detect truncation.
+  element[27] = 0xaa;
+  element[42] = 0x5a;
+  bluetooth::a2dp::MediaCodecCapabilities stored(element.data());
+  EXPECT_EQ(stored.length(), 42u);
+  EXPECT_EQ(stored[27], 0xaa);
+  EXPECT_EQ(stored[42], 0x5a);
+  EXPECT_EQ(stored.codecId(), static_cast<CodecId>(
+      bluetooth::a2dp::VendorCodecId(0x00d7, 0x00ad)));
+  btav_a2dp_codec_info_t provider{};
+  static_assert(sizeof(provider.media_codec_capabilites) == AVDT_CODEC_SIZE);
+  std::copy(element.begin(), element.end(), provider.media_codec_capabilites);
+  EXPECT_EQ(provider.media_codec_capabilites[42], 0x5a);
+}
