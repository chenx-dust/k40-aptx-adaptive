+namespace {
+enum class QcomOffloadState { Idle, Starting, Started, Stopping, Failed };
+QcomOffloadState qcom_state = QcomOffloadState::Idle;
+tBTA_AV_HNDL qcom_handle = BTA_AV_INVALID_HANDLE;
+
+void qcom_offload_callback(tBTM_VSC_CMPL* result) {
+  const bool valid = result && result->param_len >= 2;
+  const uint8_t status = valid ? result->p_param_buf[0] : 0xff;
+  const uint8_t command = valid ? result->p_param_buf[1] : 0;
+  log::info("K40 Qualcomm offload response command={:#x} status={:#x} state={}",
+            command, status, static_cast<int>(qcom_state));
+  if (qcom_state == QcomOffloadState::Stopping && valid && command == k40::kStart) {
+    // Stop was queued while start was in flight; do not acknowledge playback.
+    return;
+  }
+  if (qcom_state == QcomOffloadState::Stopping) {
+    qcom_state = valid && command == k40::kStop && status == 0
+                         ? QcomOffloadState::Idle : QcomOffloadState::Failed;
+    qcom_handle = BTA_AV_INVALID_HANDLE;
+    return;
+  }
+  if (qcom_state != QcomOffloadState::Starting) return;
+  const bool success = valid && command == k40::kStart && status == 0;
+  if (bta_av_cb.offload_start_pending_hndl != qcom_handle) {
+    qcom_state = QcomOffloadState::Failed;
+    return;
+  }
+  bta_av_cb.offload_start_pending_hndl = BTA_AV_INVALID_HANDLE;
+  // A positive rejection for invalid/unsupported parameters did not start
+  // transport. Allow a later corrected request; ambiguous replies quarantine.
+  const bool rejected = valid && command == k40::kStart &&
+                        (status == 0x01 || status == 0x11 || status == 0x12);
+  qcom_state = success ? QcomOffloadState::Started
+                      : rejected ? QcomOffloadState::Idle : QcomOffloadState::Failed;
+  if (success) bta_av_cb.offload_started_hndl = qcom_handle;
+  tBTA_AV response{};
+  response.status = success ? BTA_AV_SUCCESS : BTA_AV_FAIL_RESOURCES;
+  (*bta_av_cb.p_cback)(BTA_AV_OFFLOAD_START_RSP_EVT, &response);
+}
+
+void qcom_adaptive_start(tBTA_AV_SCB* scb) {
+  uint16_t cid = 0;
+  const uint16_t acl = get_btm_client_interface().peer.BTM_GetHCIConnHandle(
+          scb->PeerAddress(), BT_TRANSPORT_BR_EDR);
+  const auto cp = scb->p_cos->get_scmst_info(scb->PeerAddress());
+  const uint16_t mtu = k40::TransportMtu(
+          scb->stream_mtu, btif_av_is_peer_edr(scb->PeerAddress(), A2dpType::kSource),
+          btif_av_peer_supports_3mbps(scb->PeerAddress(), A2dpType::kSource));
+  const int rate = A2DP_GetTrackSampleRate(scb->cfg.codec_info);
+  const bool channel_ok = stack::l2cap::get_interface().L2CA_GetRemoteChannelId(scb->l2c_cid, &cid);
+  const auto packet = k40::BuildStart(rate, acl, cid, mtu,
+                                    cp.enable_status, cp.cp_header, scb->cfg.codec_info,
+                                    AVDT_CODEC_SIZE);
+  if (qcom_state != QcomOffloadState::Idle || !channel_ok || !packet ||
+      A2DP_GetTrackChannelCount(scb->cfg.codec_info) != 2) {
+    log::error("K40 offload rejected: state={} rate={} ACL={} CID={} MTU={}",
+               static_cast<int>(qcom_state), rate, acl, cid, mtu);
+    tBTA_AV response{};
+    response.status = BTA_AV_FAIL_RESOURCES;
+    (*bta_av_cb.p_cback)(BTA_AV_OFFLOAD_START_RSP_EVT, &response);
+    return;
+  }
+  auto bytes = *packet;
+  qcom_handle = scb->hndl;
+  qcom_state = QcomOffloadState::Starting;
+  bta_av_cb.offload_start_pending_hndl = scb->hndl;
+  bta_av_cb.offload_start_v2 = false;
+  log::info("K40 Qualcomm Adaptive start: rate={} ACL={} CID={} MTU={} bytes={}",
+            rate, acl, cid, mtu, bytes.size());
+  get_btm_client_interface().vendor.BTM_VendorSpecificCommand(
+          k40::kOpcode, bytes.size(), bytes.data(), qcom_offload_callback);
+  // CAF queues encoder mode after single-VSC start. Keep HIGH_QUALITY in
+  // sync with codec_status_aidl.cc and the DSP bridge's selected profile.
+  auto mode = k40::kHighQualityMode;
+  get_btm_client_interface().vendor.BTM_VendorSpecificCommand(
+          k40::kOpcode, mode.size(), mode.data(), [](tBTM_VSC_CMPL* result) {
+            const int status = result && result->param_len >= 1 ? result->p_param_buf[0] : -1;
+            log::info("K40 Qualcomm HQ mode response status={}", status);
+          });
+}
